<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_badge_sleep"
        android:padding="10dp"
        android:src="@drawable/ic_w_moon"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_kicker_day"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textColor="#7D8899"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_go_to_bed"
            android:textColor="#EDF1F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EDF1F7"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_tap_hint"
            android:textColor="#7D8899"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_sleep"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="@string/widget_action_sleep"
        android:textColor="#07090D"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
