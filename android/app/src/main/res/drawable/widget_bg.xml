<?xml version="1.0" encoding="utf-8"?>
<!-- Fond commun des widgets : la carte de l'appli (#0E131B) avec le halo turquoise/indigo de l'en-tête « Hygiène de vie ». -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F20E131B" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0" android:centerY="0" android:gradientRadius="220dp"
                android:startColor="#332DD4BF" android:endColor="#002DD4BF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="1" android:centerY="1" android:gradientRadius="200dp"
                android:startColor="#26818CF8" android:endColor="#00818CF8" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
