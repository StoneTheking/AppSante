<?xml version="1.0" encoding="utf-8"?>
<!-- Anneau de progression d'une quête (même dessin que sur l'accueil). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="11" android:useLevel="false">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="11" android:useLevel="true">
                <solid android:color="#FFFB923C" />
            </shape>
        </rotate>
    </item>
</layer-list>
