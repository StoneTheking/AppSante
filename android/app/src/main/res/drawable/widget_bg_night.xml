<?xml version="1.0" encoding="utf-8"?>
<!-- Nuit en cours : même carte, halo indigo (couleur « sommeil » de l'appli). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F20B0E1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0" android:centerY="0" android:gradientRadius="240dp"
                android:startColor="#47818CF8" android:endColor="#00818CF8" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#33818CF8" />
        </shape>
    </item>
</layer-list>
